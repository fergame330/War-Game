# Conexão com o PostgreSQL. Basta uma destas (a integração Prisma Postgres da Vercel cria POSTGRES_URL):
#   DATABASE_URL_POOLED -> usada pelo app (conexão com pool, recomendada na Vercel)
#   DATABASE_URL        -> usada pelas migrações (conexão direta); o app usa se não houver a com pool
#   POSTGRES_URL        -> alternativa a DATABASE_URL
# PRISMA_DATABASE_URL só é usada se for uma URL postgres:// (a do Accelerate, prisma+postgres://, é ignorada).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/guerra?schema=public"
